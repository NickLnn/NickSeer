# Copy this file to `.env` next to docker-compose.yml.
# These are HOST/runtime values only — NO service API keys go here.
# All service keys are entered inside NickSeer's Settings page.

# Timezone for logs/scheduling
TZ=Europe/Athens

# Synology user/group that owns the ./config folder.
# Matched to your other Docker containers (user: 1026:100).
PUID=1026
PGID=100
